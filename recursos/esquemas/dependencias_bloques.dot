  subgraph cluster_V { label="V. Control"; fontname="Helvetica"; color="#999999";
    node [fillcolor="#fbeeee"];
    b17 [label="17 Realimentación"]; b18 [label="18 PID"]; b19 [label="19 Trayectorias"];
    b20 [label="20 Control dinámico"]; }
  subgraph cluster_VI { label="VI. Brazo real"; fontname="Helvetica"; color="#999999";
    node [fillcolor="#eeeeee"];
    b21 [label="21 Diseño y URDF"]; b22 [label="22 Hardware y\ncalibración"]; b23 [label="23 Tareas"];
    b24 [label="24 Proyecto integrador", fillcolor="#fbeee6"]; }
  b00 -> b01; b01 -> b02; b02 -> b03; b01 -> b04; b04 -> b05; b02 -> b06; b05 -> b06;
  b03 -> b08; b07 -> b08; b08 -> b09; b08 -> b10;
  b10 -> b11; b11 -> b12; b04 -> b12; b11 -> b13; b04 -> b13;
  b13 -> b14; b06 -> b14; b05 -> b14; b14 -> b15; b14 -> b16;
  b05 -> b17; b16 -> b18; b17 -> b18; b12 -> b19; b13 -> b19; b18 -> b20; b19 -> b20; b15 -> b20;
  b15 -> b21; b16 -> b21; b21 -> b22; b18 -> b22; b20 -> b23; b22 -> b23; b23 -> b24;
