    b00 [label="00 Entorno y diagnóstico"]; b01 [label="01 Trigonometría"]; b02 [label="02 Vectores"];
    b03 [label="03 Matrices como\ntransformaciones"]; b04 [label="04 Cálculo"]; b05 [label="05 EDO y simulación"];
